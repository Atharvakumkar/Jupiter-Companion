# ==========================================
# Jupiter Companion — Configuration Template
# ==========================================
# Copy this file to .env or configure in android/local.properties
# NEVER commit production API keys or credentials to Git.

# --- Google Maps SDK for Android ---
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Restrict to package: com.antigravity.jupitercompanion.jupiter_companion
GOOGLE_MAPS_API_KEY=AIzaSyYourRestrictedGoogleMapsApiKeyHere

# --- Firebase Cloud Sync (Optional) ---
# When omitted, Jupiter Companion operates with 100% fidelity in local SQLite offline mode
FIREBASE_PROJECT_ID=jupiter-companion
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_APP_ID=1:1234567890:android:abcdef1234567890

